# Aztec Plataforma API key — generate one in Settings → API Keys
PLATFORM_API_KEY=your_api_key_here

# Base URL of the Supabase edge functions for Aztec Plataforma
# Format: https://<project-id>.supabase.co/functions/v1
PLATFORM_BASE_URL=https://your-project.supabase.co/functions/v1

# UUID of the project in Aztec Plataforma where tasks will be created
# Find it in the URL when you open the project: /project/<uuid>
PLATFORM_PROJECT_ID=your-project-uuid-here
